{
  "name": "token-saver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone extraction of OmniRoute's 12-engine prompt compression pipeline (MIT). Compresses an OpenAI-style request body before it reaches any model.",
  "main": "src/index.ts",
  "scripts": {
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "js-tiktoken": "^1.0.20",
    "omniglyph": "^1.4.0",
    "safe-regex": "^2.1.1",
    "smol-toml": "1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
